# Base URL of the conversion backend (Word->PDF etc.).
#
# Local dev:  leave as-is and run `npm run server`.
# Deployed:   point this at your conversion host, e.g.
#             VITE_API_URL=https://convert.yourdomain.com
#             (that host runs server/ — see server/README.md — with LibreOffice
#              installed. Website visitors install nothing.)
VITE_API_URL=http://localhost:5000
