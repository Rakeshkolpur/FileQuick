# --- Public site URL -------------------------------------------------------
# Your real domain, no trailing slash. Drives canonical/OG tags, sitemap.xml
# and robots.txt. Set this in the Vercel/Netlify project settings.
VITE_SITE_URL=https://filequik.in

# --- Conversion backend ---------------------------------------------------
# Base URL of the server/ Flask app (Word/PowerPoint/Excel <-> PDF, unlock,
# protect, compress). Leave unset for local dev + `npm run server`.
# Deployed: point at your conversion host, e.g.
#   VITE_API_URL=https://filequik-api.onrender.com
# That host runs server/ with LibreOffice — see server/README.md.
VITE_API_URL=http://localhost:5000

# --- Analytics (optional) --------------------------------------------------
# Google Analytics 4 Measurement ID (Admin -> Data Streams -> your web stream,
# looks like G-XXXXXXXXXX). Leave unset to keep analytics off entirely — no
# script loads and the cookie banner doesn't show. When set, the banner asks
# for consent first; it only loads after "Accept".
VITE_GA_MEASUREMENT_ID=
